# Copy to .env. 12-factor config: no localhost assumptions in code (techstack.md §3).

# Docker Postgres + pgvector is published on 5435 because 5432–5434 are already taken on this machine.
DATABASE_URL=postgres://recall:recall@localhost:5435/recall

PORT=3100

# LLM provider: ollama | bedrock
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Embeddings (1024 dims, must match the fact.embedding column). Defaults to LLM_PROVIDER.
# EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Background extraction worker in this process: on | off
EXTRACTION_WORKER=on

# Below this voice-match confidence a named speaker is treated as unknown (household facts only, and ask).
SPEAKER_CONFIDENCE_THRESHOLD=0.7

# Where console magic links point.
CONSOLE_BASE_URL=http://localhost:3000

# How the sign-in link reaches people: console | ses
# console prints it in the server log and is for development only — a deployment reachable from
# outside the team should be sending it. EMAIL_FROM must be an identity verified in SES, and while
# SES is in sandbox it will only deliver to verified addresses.
EMAIL_PROVIDER=console
# EMAIL_FROM=no-reply@example.com

# The demo owner's sign-in address. The seeded default is on a domain that cannot receive mail, so
# a deployment that actually sends links should point her at a real mailbox.
# DEMO_OWNER_EMAIL=you@example.com

# The simulated Alexa+ (`pnpm sim`), which the console's Simulator page drives.
SIM_PORT=3200
SIMULATOR_URL=http://127.0.0.1:3200

# `pnpm db:seed` registers this as an MCP token for the demo household (used by .mcp.json and pnpm smoke).
# Real households mint their own tokens: POST /households/:id/tokens.
RECALL_DEV_TOKEN=dev-token-change-me

# One-click sign-in to the seeded demo household, for judges and anyone being shown this.
# Off unless set to exactly "on". It can only ever reach the demo household — never a real
# account — because the person is looked up by household id, not by anything the caller sends.
DEMO_SIGN_IN=off
