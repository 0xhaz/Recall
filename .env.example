# Copy to .env. 12-factor config: no localhost assumptions in code (techstack.md §3).

# Docker Postgres + pgvector is published on 5435 because 5432–5434 are already taken on this machine.
DATABASE_URL=postgres://recall:recall@localhost:5435/recall

PORT=3100

# LLM provider: ollama | bedrock
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Dev-only bearer token for the MCP endpoint until per-household tokens land (week 2).
# Leave empty to disable the check on localhost.
RECALL_DEV_TOKEN=dev-token-change-me
HOUSEHOLD_TOKEN_SECRET=change-me
