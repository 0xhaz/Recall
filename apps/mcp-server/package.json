{
  "name": "@recall/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --conditions=development src/db/migrate.ts",
    "seed": "tsx --conditions=development src/db/seed.ts",
    "smoke": "tsx --conditions=development scripts/smoke.ts",
    "calibrate": "tsx --conditions=development scripts/calibrate-floors.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1132.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@recall/core": "workspace:*",
    "@recall/llm": "workspace:*",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1"
  }
}
